#!/bin/sh
# Pre-commit hook: guard the semantic-view DDL against drift.
#
# cortex_project/*.sv.yaml is the SINGLE authored source of truth; the
# scripts/deploy_semantic_view_*.sql files are generated artifacts rendered by
# scripts/generate_semantic_view_ddl.py — never hand-edit them.

REPO_ROOT="$(git rev-parse --show-toplevel)" || exit 1

# Hint (stops printing once set): this hook only fires automatically when
# core.hooksPath points at .githooks (or the hook is copied into .git/hooks).
if [ -z "$(git config core.hooksPath)" ]; then
    echo "[pre-commit] Hint: enable repo-managed hooks with: git config core.hooksPath .githooks"
fi

STAGED_FILES="$(git diff --cached --name-only)"

if echo "$STAGED_FILES" | grep -qE '^(cortex_project/[^/]+\.sv\.yaml|scripts/deploy_semantic_view_[^/]+\.sql|scripts/generate_semantic_view_ddl\.py)$'; then
    echo "[pre-commit] Verifying semantic-view DDL matches cortex_project/*.sv.yaml ..."
    if ! python3 "$REPO_ROOT/scripts/generate_semantic_view_ddl.py" --check; then
        echo "" >&2
        echo "[pre-commit] Generated semantic-view DDL is out of sync with its .sv.yaml source." >&2
        echo "[pre-commit] Fix with:" >&2
        echo "[pre-commit]   python3 scripts/generate_semantic_view_ddl.py" >&2
        echo "[pre-commit]   git add scripts/deploy_semantic_view_*.sql" >&2
        echo "[pre-commit] Never hand-edit the deploy_semantic_view_*.sql files." >&2
        exit 1
    fi
fi

exit 0
